[node name="DossierText" type="Label" parent="Panel/VBox/TabContainer/CharacterDossier/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.85, 0.88, 0.92, 1)
theme_override_font_sizes/font_size = 13
text = "JOYNAL \"JOY\" ABEDIN (Protagonist)
Former river launch pilot and master diesel mechanic defending his family against predatory dredging cartels in the Buriganga delta.

KABIR \"USTAD\" MOLLAH (Mechanic Ally)
Veteran owner of Bhai Bhai Auto Workshop. Master tuner and trusted friend of Joy's late father.

NILA CHOWDHURY (Investigative Journalist)
Tenacious investigative reporter for Dainik Prerona uncovering financial extortion in the sand syndicates.

CHAIRMAN AFSARUL HUQ (Antagonist)
Tycoon behind the illicit Balu Syndicate controlling sand dredging barges and compromised civic enforcement."
autowrap_mode = 3


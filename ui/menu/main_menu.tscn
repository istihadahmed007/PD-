size_flags_vertical = 3

[node name="ControlsText" type="Label" parent="ControlsPanel/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_font_sizes/font_size = 13
text = "ON-FOOT LOCOMOTION & COMBAT:
• [ W, A, S, D ] — Walk / Jog in all 8 directions
• [ Left Shift ] — Sprint (Hold to sprint at 12.5 m/s, drains stamina)
• [ Spacebar ] — Jump / Vault (Buffered with coyote time)
• [ E ] — Interact / Speak to NPCs / Enter Vehicle / Buy Food
• [ C ] — Crouch / Sneak
• [ Right Mouse Button ] — Hold for Over-the-Shoulder Aim Mode
• [ Left Mouse Button ] — Attack / Fire Weapon / Advance Dialogue
• [ Tab ] — Swap Weapon / Grenade

VEHICLE CONTROLS (Rickshaw, CNG, Sedan, Bus):
• [ W / S ] — Throttle Forward / Reverse & Brake
• [ A / D ] — Steer Left / Steer Right
• [ Spacebar ] — Handbrake / Drift Slide
• [ E ] — Dismount / Exit Vehicle
• [ H ] — Vehicle Horn (Dhaka City Horn)
• [ L ] — Toggle Headlights

NAVIGATION & SHORTCUTS:
• [ ESC ] — In-Game Pause Menu / Resume / Save Game
• [ J ] — Story Mission Log & Active Objectives
• [ M ] — Fullscreen World Navigation Map
• [ F3 ] — Toggle Performance Profiler Overlay"
autowrap_mode = 3


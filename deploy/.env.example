# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production and configure before deployment
# ==============================================================================

# Primary Domain (e.g., example.com)
DOMAIN_NAME=YOUR-DOMAIN.com

# PostgreSQL Credentials
POSTGRES_USER=dta_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD_2026
POSTGRES_DB=dta_bangladesh

# Node.js JWT Secret & Internal Token
JWT_SECRET=GENERATE_A_64_CHARACTER_RANDOM_SECRET_FOR_JWT_TOKENS
SERVER_API_KEY=GENERATE_A_SECRET_KEY_FOR_GODOT_TO_BACKEND_SYNC

# Multiplayer Server Settings
GAME_PORT=7777
MAX_PLAYERS=16
PROTOCOL=websocket

# SSL / TLS Settings (Certbot)
LETSENCRYPT_EMAIL=admin@YOUR-DOMAIN.com
